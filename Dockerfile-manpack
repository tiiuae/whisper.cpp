# Specify platform in base image
FROM --platform=$TARGETPLATFORM ubuntu:22.04 AS build

# Set up cross-compilation environment
RUN apt-get update && apt-get install -y \
    qemu-user-static \
    binfmt-support

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get install -y \
    git \
    cmake \
    build-essential \
    curl \
    wget \
    unzip \
    python3 \
    python3-pip \
    sox \
    ffmpeg \
    alsa-utils \
    libasound2-dev \
    libsdl2-dev \
    libssl-dev \
    libtool \
    automake \
    pkg-config \
    libopenblas-dev \
    libpulse-dev \
    pulseaudio \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /root/app

# Clone your specific repository and branch
RUN git clone -b feat/manpack https://github.com/tiiuae/whisper.cpp.git && \
    cd whisper.cpp && \
    git submodule update --init --recursive

# Install NATS.c
RUN git clone https://github.com/nats-io/nats.c.git && \
    cd nats.c && \
    mkdir build && \
    cd build && \
    cmake .. \
        -DNATS_BUILD_WITH_TLS=ON \
        -DNATS_BUILD_EXAMPLES=ON \
        -DBUILD_SHARED_LIBS=ON && \
    make -j2 && \
    make install && \
    cd ../.. && \
    rm -rf nats.c && \
    ldconfig

# Build whisper.cpp with ARM optimizations
WORKDIR /root/app/whisper.cpp
RUN mkdir -p build && \
    cd build && \
    cmake -DWHISPER_SDL2=ON \
          -DCMAKE_BUILD_TYPE=Release \
          -DWHISPER_ARM_NEON=ON \
          -DWHISPER_OPENBLAS=ON \
          -DGGML_NATIVE=OFF \
          -DGGML_CPU_ARM_ARCH=armv8-a \
          .. && \
    make -j2

# Download the model
RUN cd models && ./download-ggml-model.sh tiny.en

# Runtime stage
FROM --platform=$TARGETPLATFORM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsdl2-2.0-0 \
    libgomp1 \
    libssl3 \
    libopenblas-base \
    libpulse0 \
    pulseaudio \
    alsa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root/app

# Copy only necessary files from build stage
COPY --from=build /root/app/whisper.cpp /root/app/whisper.cpp
COPY --from=build /usr/local/lib/libnats.so* /usr/local/lib/

# Update library cache
RUN ldconfig

# Set environment variables
ENV PATH="/root/app/whisper.cpp/build/bin:${PATH}"

# Default command with correct path
CMD ["/root/app/whisper.cpp/build/bin/whisper-command", "-m", "/root/app/whisper.cpp/models/ggml-tiny.en.bin", "--capture", "0"]
